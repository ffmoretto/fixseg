# =============================================================================
# FIXSEG — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha o que for usar.
# NUNCA versione o .env.local. Chaves sem o prefixo NEXT_PUBLIC_ ficam
# disponíveis apenas no servidor (API routes) e não vazam para o navegador.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# URL pública canônica (usada em sitemap, robots, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.fixsegcorretora.com.br

# --- Contato (opcional: sobrescreve os valores de src/config/site.ts) ---------
# Telefone no formato internacional, apenas dígitos. Ex.: 5544999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=

# --- Destino dos leads --------------------------------------------------------
# Adaptador usado pela rota /api/leads: "log" | "email" | "supabase" | "crm" | "webhook"
LEADS_ADAPTER=log

# Webhook genérico (Make, n8n, Zapier, CRM próprio…)
LEADS_WEBHOOK_URL=

# --- Supabase (integração futura) --------------------------------------------
# O client anônimo só deve ser usado com RLS ativo nas tabelas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: EXCLUSIVAMENTE server-side.
SUPABASE_SERVICE_ROLE_KEY=

# --- CRM (integração futura) --------------------------------------------------
CRM_API_URL=
CRM_API_KEY=

# --- API de cotação (integração futura) --------------------------------------
QUOTE_API_URL=
QUOTE_API_KEY=

# --- Consulta de CNPJ (integração futura) ------------------------------------
CNPJ_API_URL=
CNPJ_API_KEY=

# --- Avaliações do Google (seção "O que falam de nós") -----------------------
# Alimenta a seção com as avaliações REAIS do perfil da corretora no Google
# Meu Negócio, via Places API (New). Sem as duas variáveis abaixo, a seção
# simplesmente não aparece — nenhum depoimento é inventado.
# Passo a passo para obter e restringir a chave: seção 5 do README.
#
# Chave da Places API. EXCLUSIVAMENTE server-side: sem NEXT_PUBLIC_, nunca
# chega ao navegador. Restrinja por API (só "Places API (New)").
GOOGLE_PLACES_API_KEY=
# Identificador do local (começa com "ChIJ..."), obtido no Place ID Finder.
GOOGLE_PLACE_ID=
# Opcional, apenas para testes: aponta o adaptador a outro endpoint no lugar de
# https://places.googleapis.com/v1/places. Deixe em branco em produção.
GOOGLE_PLACES_ENDPOINT=

# --- Analytics / Tags (todos opcionais; só carregam se preenchidos) ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Anti-spam (opcional) -----------------------------------------------------
# Se preenchido, a rota /api/leads valida o token do reCAPTCHA/Turnstile.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Trava de pré-visualização (homologação) ---------------------------------
# Preenchendo PREVIEW_PASSWORD, o site inteiro passa a exigir usuário e senha
# e deixa de ser indexado por buscadores. Funciona em qualquer hospedagem.
# Para publicar de verdade, apague esta variável e refaça o deploy.
PREVIEW_USER=fixseg
PREVIEW_PASSWORD=
